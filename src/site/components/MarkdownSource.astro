---
import { tokenizeMarkdownSource } from "../runtime/markdownLinks.js";

interface Props {
  source: string;
}

const { source } = Astro.props;
const tokens = tokenizeMarkdownSource(source);
---

<div class="markdown-source">
  <pre><code>{
    tokens.map((token) => token.kind === "link" ? (
      <Fragment>
        {"["}<a href={token.href} target="_blank" rel="noopener noreferrer">{token.label}</a>{`](${token.destination})`}
      </Fragment>
    ) : token.text)
  }</code></pre>
</div>
