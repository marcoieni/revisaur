---
import {
  markdownSourceTokenClassNames,
  tokenizeMarkdownSource,
  type MarkdownSourceToken,
} from "../runtime/markdownLinks.js";

interface Props {
  source: string;
}

const { source } = Astro.props;
const tokens = tokenizeMarkdownSource(source);
const html = tokens.map(renderMarkdownSourceToken).join("");

function renderMarkdownSourceToken(token: MarkdownSourceToken): string {
  const className = markdownSourceTokenClass(token);
  const content =
    token.kind === "link"
      ? `[<a href="${escapeAttribute(token.href)}" target="_blank" rel="noopener noreferrer">${escapeHtml(token.label)}</a>](${escapeHtml(token.destination)})`
      : escapeHtml(token.text);

  return className === undefined ? content : `<span class="${escapeAttribute(className)}">${content}</span>`;
}

function markdownSourceTokenClass(token: MarkdownSourceToken): string | undefined {
  const className = markdownSourceTokenClassNames(token).join(" ");
  return className.length > 0 ? className : undefined;
}

function escapeHtml(value: string): string {
  return value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
}

function escapeAttribute(value: string): string {
  return escapeHtml(value).replaceAll('"', "&quot;");
}
---

<div class="markdown-source">
  <pre><code><Fragment set:html={html} /></code></pre>
</div>
